# Copy to .env and adjust as needed.

# --- Postgres (db container) ---
POSTGRES_DB=akpedia
POSTGRES_USER=akpedia
POSTGRES_PASSWORD=akpedia

# --- Application (overrides the application.yml defaults) ---
# Running locally (outside Docker), use localhost:
# DB_URL=jdbc:postgresql://localhost:5432/akpedia
# DB_USER=akpedia
# DB_PASSWORD=akpedia
# SERVER_PORT=8080

# --- Embedding service (akpedia-ml) ---
# Inside Docker it is reached through the host (it comes up in the akpedia-ml repo's compose).
# EMBEDDING_BASE_URL=http://host.docker.internal:8000
# Running locally (outside Docker), use localhost:
# EMBEDDING_BASE_URL=http://localhost:8000
# EMBEDDING_CONNECT_TIMEOUT=2s
# EMBEDDING_READ_TIMEOUT=30s

# --- Gotenberg (document to PDF conversion) ---
# Comes up as its own container in docker-compose.yml, reached by service name.
# GOTENBERG_BASE_URL=http://gotenberg:3000
# Running locally (outside Docker), use localhost:
# GOTENBERG_BASE_URL=http://localhost:3000
# GOTENBERG_CONNECT_TIMEOUT=5s
# GOTENBERG_READ_TIMEOUT=90s

# --- Redis (document processing queue, shared with akpedia-ml) ---
# Comes up as its own container in docker-compose.yml, reached by service name.
# REDIS_HOST=redis
# Running locally (outside Docker), use localhost:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TIMEOUT=2s
# Approved documents that never reached the stream are sent again this often, once older than the grace.
# PROCESSING_RETRY_INTERVAL=30s
# PROCESSING_RETRY_GRACE=1m
# PROCESSING_RETRY_BATCH_SIZE=50

# --- Internal routes (/internal/**, called by the akpedia-ml worker) ---
# Shared secret the worker sends as X-Internal-Token; must equal the worker's INTERNAL_API_TOKEN.
# Empty means every /internal call is refused, so no approved document gets indexed.
# docker-compose.yml falls back to a development value; set a real one anywhere else.
# INTERNAL_API_TOKEN=

# --- Account deletion log ---
# Every deleted account (ids only), replayed on start to delete again what a restored backup
# brought back. Keep it outside the database backups. docker-compose.yml puts it on its own volume.
# ACCOUNT_DELETION_LOG_FILE=./data/account-deletions.jsonl
# ACCOUNT_DELETION_REPLAY_ON_STARTUP=true
# ACCOUNT_DELETION_REPLAY_RETRY_DELAY=15s

# --- Keycloak (login, accounts and roles) ---
# Self-registration is off: users are created by an admin (the app's Users screen).
# Admin console at http://localhost/auth/admin (through nginx), with the master realm admin below.
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin
# Database Keycloak keeps its data in, on the same Postgres (created by keycloak-db-init).
# KEYCLOAK_DB=keycloak
# Public URL of Keycloak (under /auth, behind nginx), which is also the token issuer.
# KEYCLOAK_URL=http://localhost/auth
# Front-end URL: akpedia-client may only redirect back here after login and logout.
# AKPEDIA_CLIENT_URL=http://localhost
# Secret of the confidential akpedia-server client (service account with view-users and manage-users).
# The server uses it for the admin's users screen; the realm import sets it on the client.
# KEYCLOAK_SERVER_CLIENT_SECRET=akpedia-dev-server-secret
# Where the server reaches Keycloak's Admin API. Inside Docker, by service name.
# KEYCLOAK_ADMIN_BASE_URL=http://keycloak:8080/auth
# Running locally (outside Docker), through nginx:
# KEYCLOAK_ADMIN_BASE_URL=http://localhost/auth

# --- nginx (single entry point: front-end, API and Keycloak on one address) ---
# AKPEDIA_HTTP_PORT=80
# Where nginx forwards each path. The defaults point at the dev container (`akpedia run`).
# KEYCLOAK_UPSTREAM=keycloak:8080
# SERVER_UPSTREAM=akpedia-devcontainer:8080
# CLIENT_UPSTREAM=akpedia-devcontainer:5173
# KEYCLOAK_REALM=akpedia
# KEYCLOAK_SERVER_CLIENT_ID=akpedia-server
# Initial ADMIN user of the akpedia realm, for development only. The password has no default:
# Keycloak refuses to start without it. Like the rest of the realm file, these are only read
# when the realm is first imported.
KEYCLOAK_DEV_ADMIN_EMAIL=admin@akpedia.local
KEYCLOAK_DEV_ADMIN_PASSWORD=
