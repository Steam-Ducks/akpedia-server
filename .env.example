# Copie para .env e ajuste conforme necessário.

# --- Postgres (container db) ---
POSTGRES_DB=akpedia
POSTGRES_USER=akpedia
POSTGRES_PASSWORD=akpedia

# --- Aplicação (sobrescreve os defaults do application.yml) ---
# Em execução local (fora do Docker), use localhost:
# DB_URL=jdbc:postgresql://localhost:5432/akpedia
# DB_USER=akpedia
# DB_PASSWORD=akpedia
# SERVER_PORT=8080

# --- Serviço de embeddings (akpedia-ml) ---
# Dentro do Docker ele é alcançado pelo host (sobe no compose do repo akpedia-ml).
# EMBEDDING_BASE_URL=http://host.docker.internal:8000
# Em execução local (fora do Docker), use localhost:
# EMBEDDING_BASE_URL=http://localhost:8000
# EMBEDDING_CONNECT_TIMEOUT=2s
# EMBEDDING_READ_TIMEOUT=30s
